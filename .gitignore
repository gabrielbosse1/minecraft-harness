# committed. Remove the tracked copy with: git rm --cached .env
.env
.env.local
*.local

# Logs & runtime artifacts
*.log
npm-debug.log*

# OS cruft
.DS_Store
Thumbs.db

# ZincAI runtime data (memories etc.)
zincai-data/

# e2e scratch rig (local verification only)
.e2e-scratch/
