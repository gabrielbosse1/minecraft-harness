# Optional local convenience file — the bot reads NO file. Configuration comes
# from environment variables (that is how the PufferPanel template passes it).
#
#   cp .env.example .env      # then edit; .env is git-ignored
#   set -a; . ./.env; set +a  # export them into the shell
#
# NEVER put a real key in this file if you intend to commit it. The panel
# deployment passes the key as a template variable and it lives only in the
# process environment.

# Required: your AMD Radeon Cloud Token Factory key.
AMD_API_KEY=

# Required: the Minecraft server the bot joins (its address and port, not the
# panel's).
MC_HOST=127.0.0.1
MC_PORT=25565

# offline = private/cracked server with the fixed name ZincAI whitelisted.
# microsoft = premium account (interactive device-code login on first run).
MC_AUTH=offline
MC_VERSION=

# Optional: model endpoint, agent tool set, chat name and language.
# AMD_API_BASE_URL=https://developer.amd.com.cn/radeon/api/v1
# AMD_MODEL=Qwen3.8-Flash-Next
# BOT_MODE=explorer
# BOT_ALIASES=zinc
# BOT_LANGUAGE=pt-BR

# Optional: operator control over chat. Comma-separated Minecraft UUIDs — a
# username is not identity. Empty means chat commands are refused and only the
# panel console can steer the bot.
ZINC_OPERATORS=
# ZINC_COMMAND_PREFIX=!zinc
# ZINC_JOIN_ON_START=true

# Optional: the agent loop. After each turn the next one starts by itself
# INFERENCE_LOOP_MS later; while the model keeps idling the gap doubles up to
# INFERENCE_HEARTBEAT_MS (0 = loop off). INFERENCE_CHAT_BATCH_MS is how long
# chat lines are collected before they are answered as one window.
# INFERENCE_LOOP_MS=8000
# INFERENCE_HEARTBEAT_MS=90000
# INFERENCE_CHAT_BATCH_MS=6000

# Optional: `update` / `restart` (console commands) restart the bot through a
# small built-in supervisor process. Set this when systemd/docker already
# restarts the process: the bot then just exits with code 75 after an update.
# ZINCAI_NO_SUPERVISOR=1

# Optional: how long without ANY decoded server packet before the link is given
# up and reconnected. Keep-alive challenges are still echoed exactly, but a
# pause in only that packet stream never disconnects an active session.
# KEEPALIVE_TIMEOUT_MS=60000

# Optional: the stall watchdog logs when the bot's own thread was blocked (with
# the function that blocked it) and when the server went silent. 0 = off.
# ZINCAI_WATCHDOG=1

# Optional: where memories, places, goals and runtime-config.json live.
# ZINC_DATA_DIR=data
# LOG_LEVEL=info
