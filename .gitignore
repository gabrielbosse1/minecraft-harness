# Dependencies
node_modules/

# Local overrides and secrets.
#
# The bot itself reads no file: configuration arrives as environment
# variables (that is how PufferPanel passes template variables). These entries
# only stop a hand-made file, a panel checkout or a private key from being
# committed by accident.
.env
.env.*
!.env.example
env/
*.pem
*.key
id_rsa*

# Runtime data (memories, places, goals, metrics).
zincai-data/
data/

# Logs
*.log
npm-debug.log*

# OS cruft
.DS_Store
Thumbs.db

# Scratch space used while debugging a session. Not part of the suite and never
# committed: anything worth keeping becomes a test file or a documented finding.
.zinc-test-run/
