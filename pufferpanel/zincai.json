{
  "type": "minecraft-java",
  "display": "Minecraft Agent (ZincAI)",
  "icon": "minecraft-java",
  "data": {
    "repo": {
      "type": "string",
      "value": "https://github.com/gabrielbosse1/minecraft-harness.git",
      "display": "Repository",
      "desc": "Clone URL of the repository the panel installs from. Point it at your fork if you maintain one; for a private repository use SSH with a deploy key on the node.",
      "required": true,
      "userEdit": true
    },
    "branch": {
      "type": "string",
      "value": "main",
      "display": "Branch",
      "desc": "Git branch to run. Re-run Install or type `update` in the console to pull new commits.",
      "required": true,
      "userEdit": true
    },
    "entrypoint": {
      "type": "string",
      "value": "zincai/index.js",
      "display": "Entry Point",
      "desc": "The bot entry file.",
      "required": true,
      "userEdit": false,
      "internal": true
    },
    "nodeversion": {
      "type": "string",
      "value": "",
      "display": "Node.js Version",
      "desc": "Leave empty to use the node's installed Node.js/npm. Only set a major version if your node PATH includes PufferPanel's nodejsdl binaries directory.",
      "required": false,
      "userEdit": true
    },
    "apikey": {
      "type": "string",
      "value": "",
      "display": "Inference API Key",
      "desc": "API key passed as AMD_API_KEY in the process environment (never written to disk).",
      "required": true,
      "userEdit": true
    },
    "model": {
      "type": "string",
      "value": "Qwen3.8-Flash-Next",
      "display": "Model",
      "desc": "Model alias served by the OpenAI-compatible endpoint.",
      "required": true,
      "userEdit": true
    },
    "amdurl": {
      "type": "string",
      "value": "https://developer.amd.com.cn/radeon/api/v1",
      "display": "API Base URL",
      "desc": "OpenAI-compatible chat completions base URL.",
      "required": true,
      "userEdit": true
    },
    "host": {
      "type": "string",
      "value": "127.0.0.1",
      "display": "Minecraft Server Address",
      "desc": "Hostname or IP of the Minecraft server to join.",
      "required": true,
      "userEdit": true
    },
    "port": {
      "type": "integer",
      "value": 25565,
      "display": "Minecraft Server Port",
      "desc": "Port of the Minecraft server to join.",
      "required": true,
      "userEdit": true
    },
    "mcversion": {
      "type": "string",
      "value": "",
      "display": "Minecraft Version",
      "desc": "Pin a protocol version (for example 1.21.4 or 26.3) or leave empty to auto-detect.",
      "required": false,
      "userEdit": true
    },
    "auth": {
      "type": "string",
      "value": "offline",
      "display": "Authentication",
      "desc": "offline joins a private/offline-mode server as ZincAI; microsoft uses a Microsoft account via device-code login.",
      "required": true,
      "userEdit": true,
      "options": [
        {
          "value": "offline",
          "display": "Offline"
        },
        {
          "value": "microsoft",
          "display": "Microsoft"
        }
      ]
    },
    "rpm": {
      "type": "integer",
      "value": 18,
      "display": "Calls Per Minute",
      "desc": "Shared inference API rate limit across chat and action lanes.",
      "required": true,
      "userEdit": true
    },
    "mininterval": {
      "type": "integer",
      "value": 3000,
      "display": "Minimum Call Spacing (ms)",
      "desc": "Shortest gap between consecutive action-lane model calls.",
      "required": true,
      "userEdit": true
    },
    "loop": {
      "type": "integer",
      "value": 8000,
      "display": "Loop Pause (ms)",
      "desc": "Delay after a turn finishes before starting the next turn; backs off up to Heartbeat when idle.",
      "required": true,
      "userEdit": true
    },
    "heartbeat": {
      "type": "integer",
      "value": 90000,
      "display": "Longest Idle Gap (ms)",
      "desc": "Maximum wait between turns while idle (0 runs strictly on world/chat events).",
      "required": true,
      "userEdit": true
    },
    "maxattempts": {
      "type": "integer",
      "value": 40,
      "display": "Reconnect Attempts",
      "desc": "How many times a dropped connection is retried with back-off before exiting.",
      "required": true,
      "userEdit": true
    },
    "log": {
      "type": "string",
      "value": "info",
      "display": "Log Level",
      "desc": "Console log verbosity (debug, info, warn, error).",
      "required": true,
      "userEdit": true,
      "options": [
        {
          "value": "debug",
          "display": "Debug"
        },
        {
          "value": "info",
          "display": "Info"
        },
        {
          "value": "warn",
          "display": "Warning"
        },
        {
          "value": "error",
          "display": "Error"
        }
      ]
    },
    "datadir": {
      "type": "string",
      "value": "data",
      "display": "Data Directory",
      "desc": "Directory storing session telemetry (events + continuation snapshots), memories, places, goals, and journal.",
      "required": true,
      "userEdit": false
    },
    "dockerimage": {
      "type": "string",
      "value": "node:22-bookworm-slim",
      "display": "Docker Image",
      "desc": "Docker image used only on Docker nodes (must include Node.js and npm).",
      "required": false,
      "userEdit": true
    }
  },
  "groups": [
    {
      "display": "Endpoint",
      "description": "Model endpoint configuration and API key.",
      "variables": [
        "apikey",
        "model",
        "amdurl"
      ],
      "order": 1
    },
    {
      "display": "Minecraft Server",
      "description": "Target Minecraft server connection.",
      "variables": [
        "host",
        "port",
        "mcversion",
        "auth"
      ],
      "order": 2
    },
    {
      "display": "Pacing & Recovery",
      "description": "API rate pacing, reconnect attempts, and console log level. Every gameplay tool is always available without modes or behavior switches.",
      "variables": [
        "rpm",
        "mininterval",
        "loop",
        "heartbeat",
        "maxattempts",
        "log"
      ],
      "order": 3
    },
    {
      "display": "Installation",
      "description": "Source repository, runtime, and persistent data directory.",
      "variables": [
        "repo",
        "branch",
        "nodeversion",
        "datadir",
        "dockerimage"
      ],
      "order": 4
    }
  ],
  "install": [
    {
      "if": "!in_path('git')",
      "type": "command",
      "commands": [
        "echo 'git is required: install git on the node and run Install again' && exit 1"
      ]
    },
    {
      "if": "!file_exists('.git')",
      "type": "command",
      "commands": [
        "git clone --depth 1 --branch ${branch} ${repo} ."
      ]
    },
    {
      "if": "file_exists('.git')",
      "type": "command",
      "commands": [
        "git fetch --depth 1 origin ${branch}",
        "git checkout -B ${branch} FETCH_HEAD"
      ]
    },
    {
      "if": "(env == 'host' || env == 'tty' || env == 'standard') && os != 'windows' && nodeversion != ''",
      "type": "nodejsdl",
      "version": "${nodeversion}"
    },
    {
      "type": "command",
      "commands": [
        "npm ci --omit=dev --no-audit --no-fund"
      ]
    },
    {
      "type": "mkdir",
      "target": "${datadir}"
    }
  ],
  "run": {
    "pre": [
      {
        "type": "command",
        "commands": [
          "node ${entrypoint} --dry-run"
        ]
      }
    ],
    "command": [
      {
        "command": "node ${entrypoint}"
      }
    ],
    "stopCode": 2,
    "stdin": {
      "type": "stdin"
    },
    "environmentVars": {
      "NODE_ENV": "production",
      "AMD_API_KEY": "${apikey}",
      "AMD_API_BASE_URL": "${amdurl}",
      "AMD_MODEL": "${model}",
      "MC_HOST": "${host}",
      "MC_PORT": "${port}",
      "MC_VERSION": "${mcversion}",
      "MC_AUTH": "${auth}",
      "INFERENCE_RPM": "${rpm}",
      "INFERENCE_MIN_INTERVAL_MS": "${mininterval}",
      "INFERENCE_LOOP_MS": "${loop}",
      "INFERENCE_HEARTBEAT_MS": "${heartbeat}",
      "RECONNECT_MAX_ATTEMPTS": "${maxattempts}",
      "ZINC_DATA_DIR": "${datadir}",
      "LOG_LEVEL": "${log}"
    },
    "autostart": true,
    "autorecover": false,
    "autorestart": false
  },
  "environment": {
    "type": "host"
  },
  "supportedEnvironments": [
    {
      "type": "host"
    },
    {
      "type": "tty"
    },
    {
      "type": "standard"
    },
    {
      "type": "docker",
      "image": "${dockerimage}"
    }
  ],
  "requirements": {
    "binaries": [
      "node",
      "npm"
    ]
  }
}
