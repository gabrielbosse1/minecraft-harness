# Optional local shell file — ZincAI reads configuration strictly from
# process environment variables (same interface used by PufferPanel).
#
#   cp .env.example .env      # edit; .env is git-ignored
#   set -a; . ./.env; set +a  # export into current shell

# Required: API key for the OpenAI-compatible inference endpoint
AMD_API_KEY=

# Required: Minecraft server target
MC_HOST=127.0.0.1
MC_PORT=25565
MC_AUTH=offline
MC_VERSION=

# Optional: model endpoint and pacing
# AMD_API_BASE_URL=https://developer.amd.com.cn/radeon/api/v1
# AMD_MODEL=Qwen3.8-27B
# Leave AMD_MAX_TOKENS / INFERENCE_CHAT_MAX_TOKENS / AMD_CONTEXT_WINDOW unset
# to use the model's standard token limits with proactive headroom compaction.
# AMD_MAX_TOKENS=
# AMD_CONTEXT_WINDOW=
# INFERENCE_CHAT_MAX_TOKENS=
# AMD_TEMPERATURE=0.25
# AMD_API_TIMEOUT_MS=120000
# AMD_CHAT_TIMEOUT_MS=90000
# Ceilings the adaptive deadline may grow to after a real timeout (a call that
# timed out earns more room instead of retrying into the same wall).
# AMD_MAX_TIMEOUT_MS=180000
# AMD_CHAT_MAX_TIMEOUT_MS=120000
# AMD_MAX_CONCURRENT=2

# Optional: agent loop & API rate pacing
# INFERENCE_RPM=18
# INFERENCE_MIN_INTERVAL_MS=3000
# INFERENCE_LOOP_MS=8000
# INFERENCE_HEARTBEAT_MS=90000
# INFERENCE_CHAT_BATCH_MS=6000

# Optional: connection recovery & process supervision
# RECONNECT_MAX_ATTEMPTS=40
# KEEPALIVE_TIMEOUT_MS=60000
# ZINCAI_NO_SUPERVISOR=1
# ZINCAI_WATCHDOG=1

# Optional: data/telemetry directory (default: ./data) and console log level
# ZINC_DATA_DIR=data
# LOG_LEVEL=info

# Optional live visual feed (off when port is 0). No authentication.
# VISION_FEED_PORT=3000
# VISION_FEED_HOST=127.0.0.1
